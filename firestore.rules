rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Validation Helper: Level ---
    function isValidLevel(data) {
      return data.id is int && data.id >= 1 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.subtitle is string && data.subtitle.size() <= 100 &&
             data.topic is string && data.topic.size() <= 100 &&
             data.scenarioDescription is string && data.scenarioDescription.size() <= 1000 &&
             data.objective is string && data.objective.size() <= 500 &&
             data.moralMessage is string && data.moralMessage.size() <= 500 &&
             data.rewardCoins is int && data.rewardCoins >= 0 &&
             data.rewardXp is int && data.rewardXp >= 0 &&
             data.rewardCivicPoints is int && data.rewardCivicPoints >= 0 &&
             data.world is int && data.world >= 1 &&
             data.worldTitle is string && data.worldTitle.size() <= 100 &&
             data.isPublished is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Validation Helper: UserProfile ---
    function isValidUserProfile(data, expectedUserId) {
      return data.userId is string && data.userId == expectedUserId &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.coins is int && data.coins >= 0 &&
             data.xp is int && data.xp >= 0 &&
             data.civicPoints is int && data.civicPoints >= 0 &&
             data.unlockedBadges is list && data.unlockedBadges.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Validation Helper: LevelProgress ---
    function isValidLevelProgress(data, expectedUserId) {
      return data.levelId is int && data.levelId >= 1 &&
             data.stars is int && data.stars >= 1 && data.stars <= 3 &&
             data.firstTry is bool &&
             data.userId is string && data.userId == expectedUserId &&
             data.completedAt is timestamp && data.completedAt <= request.time;
    }

    // --- Levels Collection: Dynamic civic game levels ---
    match /levels/{levelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    (!('authorId' in request.resource.data) || request.resource.data.authorId == request.auth.uid) &&
                    isValidLevel(request.resource.data);
      allow update: if isAuthenticated() &&
                    (!('authorId' in resource.data) || resource.data.authorId == request.auth.uid) &&
                    isValidLevel(request.resource.data);
      allow delete: if isAuthenticated() &&
                    ('authorId' in resource.data && resource.data.authorId == request.auth.uid);
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;

      // User's level completions
      match /progress/{progressId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLevelProgress(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidLevelProgress(request.resource.data, userId);
        allow delete: if false;
      }
    }
  }
}
